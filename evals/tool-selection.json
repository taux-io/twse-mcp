{
  "description": "常見問法 → 第一個工具呼叫應該是什麼。每題的 expect 是可接受的選項（任一符合即通過）；args 是部分比對，只寫必須出現的參數。",
  "cases": [
    { "id": "realtime-etf", "question": "0050 現在多少？",
      "expect": [{ "tool": "quote.realtime", "args": { "codes": ["0050"] } }] },
    { "id": "lookup-name", "question": "隴華的股票代號是多少？",
      "expect": [{ "tool": "quote.lookup" }] },
    { "id": "stock-valuation", "question": "幫我看 2330 的本益比、殖利率和最近月營收",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2330" } }] },
    { "id": "stock-financials", "question": "2330 今年上半年的毛利率和每股盈餘是多少？",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2330", "include_financials": true } }] },
    { "id": "stock-governance", "question": "2317 的董事長有沒有兼任總經理？董監有沒有質押股票？",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2317", "include_governance": true } }] },
    { "id": "stock-by-name-financials", "question": "聯電最新一季的每股淨值是多少？",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "snapshot.stock", "args": { "code": "2303", "include_financials": true } }
      ] },
    { "id": "stock-dividend", "question": "2330 最近一次配多少現金股利？什麼時候除息？",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2330" } }] },
    { "id": "stock-dividend-by-name", "question": "中華電今年配多少股利？",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "snapshot.stock", "args": { "code": "2412" } }
      ] },
    { "id": "stock-margin", "question": "2330 的融資餘額最近是增加還是減少？券資比多少？",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2330", "include_margin": true } }] },
    { "id": "stock-sbl-by-name", "question": "長榮今天還可以借券賣出多少股？",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "snapshot.stock", "args": { "code": "2603", "include_margin": true } }
      ] },
    { "id": "stock-disposition", "question": "2330 現在有沒有被列為處置股或注意股？",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2330" } }] },
    { "id": "etf-profile", "question": "0056 這檔 ETF 在追蹤什麼指數？有多少人定期定額？",
      "expect": [{ "tool": "snapshot.etf", "args": { "code": "0056" } }] },
    { "id": "etf-by-name", "question": "元大高股息現在多少錢？",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "quote.realtime", "args": { "codes": ["0056"] } }
      ] },
    { "id": "screen-top-yield", "question": "上市股票裡殖利率最高的前 10 檔是哪些？",
      "expect": [
        { "tool": "dataset.search" },
        { "tool": "dataset.describe", "args": { "dataset_id": "exchangeReport/BWIBBU_ALL" } },
        { "tool": "dataset.get", "args": { "dataset_id": "exchangeReport/BWIBBU_ALL", "sort_by": "DividendYield" } }
      ] },
    { "id": "screen-where", "question": "本益比低於 10 而且殖利率 6% 以上的股票有哪些？",
      "expect": [
        { "tool": "dataset.search" },
        { "tool": "dataset.describe", "args": { "dataset_id": "exchangeReport/BWIBBU_ALL" } },
        { "tool": "dataset.get", "args": { "dataset_id": "exchangeReport/BWIBBU_ALL", "where": [{ "field": "PEratio", "op": "lt" }] } }
      ] },
    { "id": "screen-revenue-growth", "question": "上個月營收年增率最高的上市公司是哪幾家？",
      "expect": [
        { "tool": "dataset.search" },
        { "tool": "dataset.get", "args": { "dataset_id": "opendata/t187ap05_L" } }
      ] },
    { "id": "market-today", "question": "今天台股大盤表現怎麼樣？成交量大嗎？",
      "expect": [{ "tool": "snapshot.market" }] },
    { "id": "market-futures", "question": "外資在台指期現在是偏多還是偏空？",
      "expect": [{ "tool": "snapshot.market" }, { "tool": "snapshot.futures" }] },
    { "id": "market-pcr", "question": "最近的台指選擇權 Put/Call ratio 是多少？",
      "expect": [
        { "tool": "snapshot.market" },
        { "tool": "dataset.search" },
        { "tool": "dataset.get", "args": { "dataset_id": "taifex/PutCallRatio" } }
      ] },
    { "id": "discover-margin", "question": "證交所有沒有融資融券餘額的資料？",
      "expect": [{ "tool": "dataset.search" }] },
    { "id": "discover-esg", "question": "我想看台積電的溫室氣體排放 ESG 揭露資料",
      "expect": [
        { "tool": "snapshot.stock", "args": { "code": "2330", "esg_topics": ["溫室氣體排放"] } },
        { "tool": "dataset.search" }
      ] },
    { "id": "esg-board", "question": "中鋼的女性董事比例是多少？",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "snapshot.stock", "args": { "code": "2002", "esg_topics": ["董事會"] } }
      ] },
    { "id": "esg-industry", "question": "2454 聯發科去年有沒有發生資訊外洩事件？",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2454", "esg_topics": ["資訊安全"] } }] },
    { "id": "discover-exdividend", "question": "這週有哪些上市股票要除息？",
      "expect": [
        { "tool": "snapshot.market", "args": { "scope": "events" } },
        { "tool": "dataset.search" },
        { "tool": "dataset.get", "args": { "dataset_id": "exchangeReport/TWT48U_ALL" } }
      ] },
    { "id": "events-agm", "question": "接下來兩週有哪些上市公司要開股東會？",
      "expect": [
        { "tool": "snapshot.market", "args": { "scope": "events" } },
        { "tool": "dataset.search" }
      ] },
    { "id": "events-disposition", "question": "現在有哪些股票被列為處置股？",
      "expect": [
        { "tool": "snapshot.market", "args": { "scope": "events" } },
        { "tool": "dataset.search" }
      ] },
    { "id": "events-notice", "question": "今天證交所公布了哪些注意股？",
      "expect": [
        { "tool": "snapshot.market", "args": { "scope": "events" } },
        { "tool": "dataset.search" }
      ] },
    { "id": "discover-fx", "question": "美元兌台幣的參考匯率是多少？",
      "expect": [
        { "tool": "dataset.search" },
        { "tool": "dataset.get", "args": { "dataset_id": "taifex/DailyForeignExchangeRates" } }
      ] },
    { "id": "futures-quote", "question": "台指期昨天收在哪裡？",
      "expect": [
        { "tool": "snapshot.futures" },
        { "tool": "dataset.search" },
        { "tool": "dataset.get", "args": { "dataset_id": "taifex/DailyMarketReportFut" } }
      ] },
    { "id": "futures-code", "question": "小型臺指期貨（MXF）最近的成交量是多少？",
      "expect": [
        { "tool": "snapshot.futures" },
        { "tool": "dataset.search" },
        { "tool": "dataset.get", "args": { "code": "MXF" } }
      ] },
    { "id": "futures-mini", "question": "小台近月昨天結算價多少？未平倉有多少口？",
      "expect": [{ "tool": "snapshot.futures" }] },
    { "id": "futures-stock-large", "question": "台積電期貨的大額交易人偏多還是偏空？",
      "expect": [{ "tool": "snapshot.futures" }] },
    { "id": "options-not-futures", "question": "台指選擇權 10 月份 48000 買權昨天收多少？",
      "expect": [{ "tool": "dataset.search" }] },
    { "id": "otc-by-name", "question": "環球晶現在股價多少？",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "quote.realtime", "args": { "market": "otc" } }
      ] },
    { "id": "otc-by-code", "question": "上櫃的 6488 現在多少？",
      "expect": [{ "tool": "quote.realtime", "args": { "codes": ["6488"], "market": "otc" } }] },
    { "id": "yesterday-close", "question": "0050 昨天的收盤價和成交量？",
      "expect": [
        { "tool": "snapshot.etf", "args": { "code": "0050" } },
        { "tool": "dataset.get", "args": { "dataset_id": "exchangeReport/STOCK_DAY_ALL", "code": "0050" } },
        { "tool": "quote.realtime", "args": { "codes": ["0050"] } }
      ] },
    { "id": "en-realtime-name", "question": "What's TSMC trading at right now?",
      "expect": [{ "tool": "quote.lookup" }, { "tool": "quote.realtime", "args": { "codes": ["2330"] } }] },
    { "id": "en-lookup", "question": "What is the stock code for Chunghwa Telecom on the Taiwan Stock Exchange?",
      "expect": [{ "tool": "quote.lookup" }] },
    { "id": "en-valuation", "question": "Show me the P/E ratio, dividend yield and latest monthly revenue for 2330.",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2330" } }] },
    { "id": "en-financials-name", "question": "What was UMC's EPS in the latest quarter?",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "snapshot.stock", "args": { "code": "2303", "include_financials": true } }
      ] },
    { "id": "en-governance-name", "question": "Does Hon Hai's chairman also serve as president, and have its directors pledged shares?",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "snapshot.stock", "args": { "code": "2317", "include_governance": true } }
      ] },
    { "id": "en-margin", "question": "Is margin buying in 2330 going up or down lately?",
      "expect": [{ "tool": "snapshot.stock", "args": { "code": "2330", "include_margin": true } }] },
    { "id": "en-esg", "question": "What greenhouse gas emissions has TSMC disclosed in its ESG data?",
      "expect": [
        { "tool": "quote.lookup" },
        { "tool": "snapshot.stock", "args": { "code": "2330", "esg_topics": ["溫室氣體排放"] } },
        { "tool": "dataset.search" }
      ] },
    { "id": "en-etf", "question": "Which index does the 0056 ETF track?",
      "expect": [{ "tool": "snapshot.etf", "args": { "code": "0056" } }] },
    { "id": "en-market", "question": "How did the Taiwan stock market do today?",
      "expect": [{ "tool": "snapshot.market" }] },
    { "id": "en-exdividend", "question": "Which Taiwan-listed stocks go ex-dividend in the next two weeks?",
      "expect": [{ "tool": "snapshot.market", "args": { "scope": "events" } }, { "tool": "dataset.search" }] },
    { "id": "en-futures", "question": "Where did TAIEX futures settle yesterday, and what's the open interest?",
      "expect": [{ "tool": "snapshot.futures" }] },
    { "id": "en-screen-yield", "question": "Which 10 Taiwan-listed stocks have the highest dividend yield?",
      "expect": [
        { "tool": "dataset.search" },
        { "tool": "dataset.describe", "args": { "dataset_id": "exchangeReport/BWIBBU_ALL" } },
        { "tool": "dataset.get", "args": { "dataset_id": "exchangeReport/BWIBBU_ALL", "sort_by": "DividendYield" } }
      ] }
  ]
}
