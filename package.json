{
  "name": "twse-mcp",
  "version": "0.3.0",
  "description": "Remote MCP server for the Taiwan Stock Exchange (TWSE) OpenAPI, on Cloudflare Workers",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir=dist",
    "refresh-catalog": "node scripts/refresh-catalog.mjs",
    "check-catalog": "node scripts/check-catalog.mjs",
    "check-readmes": "node scripts/check-readmes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "make-og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^26.0.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.114.0"
  }
}
