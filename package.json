{
  "name": "twse-mcp",
  "version": "0.15.0",
  "description": "Taiwan Market Open Data (Unofficial): remote MCP server for TWSE and TAIFEX open data, on Cloudflare Workers. Not affiliated with TWSE or TAIFEX.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir=dist",
    "refresh-catalog": "node scripts/refresh-catalog.mjs",
    "check-catalog": "node scripts/check-catalog.mjs",
    "check-required-checks": "node scripts/check-required-checks.mjs",
    "check-readmes": "node scripts/check-readmes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "make-og": "node scripts/make-og.mjs",
    "make-icons": "node scripts/make-icons.mjs",
    "eval:tools": "node scripts/eval-tools.mjs",
    "eval:ab": "node scripts/eval-ab.mjs",
    "smoke": "node scripts/smoke.mjs",
    "call": "node scripts/call.mjs",
    "pr:wait": "node scripts/pr-wait.mjs",
    "main-wait": "node scripts/main-wait.mjs",
    "eval:answers": "node scripts/eval-answers.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.31.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
