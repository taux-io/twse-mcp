                "供應鏈管理",
                "產品品質與安全",
                "社區關係",
                "資訊安全",
                "普惠金融",
                "持股及控制力",
                "風險管理政策",
                "反競爭行為法律訴訟",
                "職業安全衛生",
              ],
              "type": "string",
            },
            "maxItems": 6,
            "type": "array",
          },
          "include_financials": {
            "default": false,
            "type": "boolean",
          },
          "include_governance": {
            "default": false,
            "type": "boolean",
          },
          "include_margin": {
            "default": false,
            "type": "boolean",
          },
        },
        "type": "object",
      },
      "name": "snapshot.stock",
    },
    {
      "input": {
        "properties": {
          "scope": {
            "default": "all",
            "enum": [
              "all",
              "stock",
              "futures",
              "events",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "snapshot.market",
    },
    {
      "input": {
        "properties": {
          "contract": {
            "type": "string",
          },
        },
        "required": [
          "contract",
        ],
        "type": "object",
      },
      "name": "snapshot.futures",
    },
    {
      "input": {
        "properties": {
          "codes": {
            "items": {
              "pattern": "^[0-9A-Za-z]{1,10}$",
              "type": "string",
            },
            "maxItems": 50,
            "type": "array",
          },
          "market": {
            "default": "tse",
            "enum": [
              "tse",
              "otc",
            ],
            "type": "string",
          },
        },
        "required": [
          "codes",
        ],
        "type": "object",
      },
      "name": "quote.realtime",
    },
  ],
}
`;

