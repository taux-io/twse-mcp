          },
          "order": {
            "default": "desc",
            "enum": [
              "desc",
              "asc",
            ],
            "type": "string",
          },
          "sort_by": {
            "default": "",
            "type": "string",
          },
          "where": {
            "items": {
              "properties": {
                "field": {
                  "type": "string",
                },
                "op": {
                  "enum": [
                    "gt",
                    "gte",
                    "lt",
