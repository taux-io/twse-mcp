{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twse-mcp",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],

  // 關掉 *.workers.dev 那個 origin，只留自訂網域。
  //
  // 兩個 origin 同時活著時，任何掛在 taux.io 這個 zone 上的 WAF 或 rate limit 規則，
  // workers.dev 那條路都繞得過去——而且是**安靜地**繞過：你會以為擋住了。
  // 這不是現在的問題（服務公開、唯讀、無認證，兩個 origin 給的東西一樣），
  // 而是 docs/spec-workers-migration.md 明文把速率限制列為「日後再加」，
  // 所以那個「日後」是排定會發生的。設定要在它之前做，不是之後。
  //
  // 代價：twse-mcp.taux-io.workers.dev 部署後立即停止服務。README、server.json
  // 與所有目錄登錄用的都是 twse-mcp.taux.io，那個主機名從未對外文件化過。
  "workers_dev": false,
  // 意圖不變：只開 logs，traces 對這個唯讀 server 用不到，關著省資源。
  // 改的是寫法——先前是 `enabled: false` 配 `logs.enabled: true`，而那個組合的語意
  // Cloudflare **文件從未規定**（文件那一節只記載頂層兩個欄位，完全沒提到 logs /
  // traces 子物件，也沒有任何一頁說明優先順序）。只有 wrangler 的實作推導得出
  // 「巢狀值勝出、log 會落地」，最終裁決者卻是閉源的控制平面。issue #36 的量測要靠
  // 這些 log 撐起收斂決定，不該建立在未文件化的行為上，所以頂層改為明確開啟。
  //
  // 兩個先前註解裡已被推翻的說法，記在這裡免得有人照著它們做決定：
  //   - 「與儀表板的實際設定對齊，避免每次部署互相覆蓋」——不適用於本欄位。
  //     wrangler 的遠端／本地設定比對**刻意排除** observability，因為它的遠端預設
  //     行為與 wrangler 不同。
  //   - 「`wrangler tail` 除錯靠它」——不是。tail 是另一個子系統，不受本設定影響。
  //
  // 「頂層開了，traces 會不會跟著開？」——不會，而且真正的保障不是下面那行
  // `traces.enabled: false`。Cloudflare 的 traces 文件寫明：自動追蹤仍在 early beta，
  // 頂層 `enabled = true` **目前只會開 logs**，日後要讓它同時開 traces 還需要更新
  // `compatibility_date` 才會生效。所以擋著 traces 的是這個 compatibility_date，
  // 下面那行是第二道、不依賴巢狀優先順序的明示。兩者都留著。
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
